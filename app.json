{
  "expo": {
    "name": "Lunéa",
    "slug": "lunea",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.lunea.cycle",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDE3E8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.lunea.cycle",
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Lunéa",
      "shortName": "Lunéa",
      "lang": "fr",
      "themeColor": "#E2556F",
      "backgroundColor": "#FFF7F8"
    },
    "scheme": "lunea",
    "backgroundColor": "#FFF7F8",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF7F8"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Lunéa utilise Face ID pour protéger vos données."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E2556F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "baseUrl": "/lunea"
    }
  }
}